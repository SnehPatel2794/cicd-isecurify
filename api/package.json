  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:bootstrap": "tsx src/dbbootstrap.ts",
    "db:setup": "tsx src/dbsetup.ts",
