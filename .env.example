# Copy to .env and fill in. NEVER commit .env.
DOMAIN=grc.example.com
# Database passwords go into connection addresses: use letters and digits only, e.g.  openssl rand -hex 24  (base64 can contain / + = which break them).
MYSQL_ROOT_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Optional. Set a random value to switch on "Wipe demo organization" (docs/DEMO_DATA.md); leave empty to keep the wipe button off.
PURGE_DB_PASSWORD=
# 32 random bytes, base64:   openssl rand -base64 32
MFA_ENC_KEY=
# any long random string:    openssl rand -base64 48
CSRF_KEY=
# Optional: switches on outgoing webhooks. 32 random bytes, base64 (openssl rand -base64 32). A different value from MFA_ENC_KEY. Leave empty to keep webhooks off.
WEBHOOK_ENC_KEY=

# Phase 5 evidence (all optional)
# EVIDENCE_MAX_FILE_MB=25
# EVIDENCE_DEFAULT_QUOTA_MB=0           # per organization; 0 = no limit (default). Administrators can still set a limit for one organization
# EVIDENCE_MIN_FREE_MB=1024             # uploads pause when the evidence disk has less than this free (0 = guard off)
# EVIDENCE_LINK_HOSTS=drive.google.com,docs.google.com   # restrict evidence links to these hosts (empty = any https link)
# Malware scanning (optional). Run `docker compose --profile scan up -d` and set:
# CLAMAV_HOST=clamav:3310
# EVIDENCE_AUTO_SCAN=true     # scan every new file automatically (needs CLAMAV_HOST)

# --- Outgoing email (Phase 7A). The worker sends invitations and password resets. See docs/EMAIL.md.
# Google Workspace (Gmail SMTP): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=starttls, SMTP_USER=<the mailbox>, SMTP_PASSWORD=<an App Password, never the account password>,
# MAIL_FROM must be that mailbox or an alias added to it ("Send mail as"). Needs 2-Step Verification on the account. See docs/EMAIL.md.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 587 for STARTTLS, 465 for implicit TLS
# SMTP_TLS=starttls              # starttls (default, encryption required) | tls | none (development only, refused in production)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=iSecurify GRC <noreply@your-domain.com>
# MAIL_REPLY_TO=

# --- Backups (deploy/backup.sh). No secrets here: BACKUP_GPG_RECIPIENT is a public key id or email. ---
# BACKUP_DIR=/var/backups/isecurify
# BACKUP_GPG_RECIPIENT=backups@your-domain.com
# Off-server copy (optional, off by default): BACKUP_OFFSITE=rclone|rsync|command. See docs/RUNBOOK.md.
# BACKUP_OFFSITE=rsync
# BACKUP_OFFSITE_TARGET=user@backup-host:/srv/isecurify-backups   # rclone: remote:bucket/path
# BACKUP_RSYNC_SSH=ssh -i /home/deploy/.ssh/backup_key -p 2222
# BACKUP_OFFSITE_KEEP_DAYS=30
# BACKUP_PUSH_CMD=rclone copy "$BACKUP_OUT" remote:isecurify   # command mode
# ALERT_MIN_FREE_MB=2048                 # administrators are emailed when the disk has less free than this
# BACKUP_MIN_KEEP=7
# BACKUP_KEEP_DAYS=14

# --- Logs (deploy/ship-logs.sh, nightly). Bundles are kept in $BACKUP_DIR/logs; set LOG_SHIP to also copy them off the server. No secrets here.
# LOG_SHIP=rsync                 # none (default) | rclone | rsync | command
# LOG_SHIP_TARGET=user@log-host:/srv/isecurify-logs   # use a different path from the backups
# LOG_SHIP_SSH=ssh -i /home/deploy/.ssh/log_key -p 2222
# LOG_KEEP_DAYS=30
# --- Staging only (see docs/STAGING.md): APP_ENV=staging, HTTP_PORT, HTTPS_PORT, APP_ORIGIN_OVERRIDE. Production leaves these out.
