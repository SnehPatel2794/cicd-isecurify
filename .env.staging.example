# Copy to .env in the STAGING directory. Never reuse a production secret here: generate new ones (openssl rand -base64 32).
APP_ENV=staging
DOMAIN=staging.grc.example.com
# Only when staging uses ports other than 80/443 (for example on the same server as production):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# APP_ORIGIN_OVERRIDE=https://staging.grc.example.com:8443
MYSQL_ROOT_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
MFA_ENC_KEY=
CSRF_KEY=
# Leave SMTP_HOST and the other SMTP_ lines OUT: staging must not send email.
# WEBHOOK_ENC_KEY is left out on purpose: webhooks stay off.
